.muted{color:var(--muted);font-size:13px}
.badge{display:inline-block;background:#eaf1ff;color:var(--blue);padding:5px 8px;border-radius:30px;font-size:12px;font-weight:700}
.row{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.panel{background:#fff;border-radius:16px;padding:17px;margin-bottom:15px;box-shadow:0 3px 14px #13294b10}
.hidden{display:none!important}
.statgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
.stat{background:#f5f8ff;padding:15px;border-radius:13px}
.stat b{font-size:22px}
.profile{display:flex;align-items:center;gap:10px}
.avatar{width:45px;height:45px;border-radius:50%;object-fit:cover;background:#dce7ff;display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--blue)}
.modal{position:fixed;inset:0;background:#0008;display:none;align-items:center;justify-content:center;padding:14px;z-index:500}
.modal.show{display:flex}
.modalbox{background:#fff;width:min(620px,100%);max-height:92vh;overflow:auto;border-radius:18px;padding:18px}
.login-bg{background:linear-gradient(135deg,#063ea8,#3287ff);min-height:100vh;padding:25px 15px;display:flex;align-items:center;justify-content:center}
.loginbox{width:min(480px,100%);background:#fff;border-radius:22px;padding:22px;box-shadow:0 15px 50px #001d4d55}
.login-title{text-align:center;color:var(--blue);font-size:28px;font-weight:900}
.notice{background:#fff7df;border:1px solid #f2d37a;padding:11px;border-radius:10px;color:#6d5100}
.comment,.msg{padding:10px;border-bottom:1px solid #edf0f4}
.chat{height:300px;overflow:auto;background:#f4f6f9;border-radius:12px;padding:8px}
.my{background:#dfeaff;border-radius:10px;margin:5px 0;padding:9px;text-align:right}
.other{background:#fff;border-radius:10px;margin:5px 0;padding:9px}
.like{background:#fff0f1;color:#c62828}
.notif-list{max-height:350px;overflow:auto}
.notif{padding:11px;border-bottom:1px solid #edf0f4}
.unread{background:#eef4ff}
.profile-menu{position:absolute;right:12px;top:58px;background:#fff;border:1px solid #e3e8ef;border-radius:14px;box-shadow:0 8px 30px #0002;padding:8px;width:230px;display:none}
.profile-menu.show{display:block}
.profile-menu button{display:block;width:100%;text-align:left;margin:3px 0;background:#fff;color:#172033}
footer{background:#172033;color:#fff;text-align:center;padding:25px;margin-top:30px}
@media(max-width:650px){.hero h1{font-size:24px}.actions button span{display:none}.nav button{font-size:12px;padding:9px}.media{height:190px}}

/* HOME IS PUBLIC: login appears only when an action needs it */
#authScreen{display:none!important}
</style>
</head>
<body>

<div id="app"></div>

<!-- AUTH -->
<div id="authScreen" class="login-bg">
  <div class="loginbox">
    <div class="login-title">🛍️ Zunivo</div>
    <p style="text-align:center">Marketplace y'abaguzi n'abacuruzi</p>
    <div class="row">
      <button id="sellerLoginTab" style="flex:1" onclick="setRole('seller')">🏪 Kwinjira nk'umucuruzi</button>
      <button id="customerLoginTab" class="secondary" style="flex:1" onclick="setRole('customer')">🛒 Kwinjira nk'umukiriya</button>
    </div>
    <h3 id="authTitle">Kwinjira nk'umucuruzi</h3>
    <input id="authName" placeholder="Amazina (bisabwa kuri signup)">
    <input id="authEmail" type="email" placeholder="Email">
    <input id="authPassword" type="password" placeholder="Password">
    <input id="authCity" placeholder="Umujyi / Akarere">
    <div class="row">
      <button style="flex:1" onclick="signIn()">🔐 Injira</button>
      <button class="secondary" style="flex:1" onclick="signUp()">📝 Fungura account</button>
    </div>
    <p id="authMsg" class="muted"></p>
    <div class="notice">Kugira ngo login, products, comments, likes na chat bibe nyabyo, shyiramo Supabase URL na anon key muri code hepfo.</div>
  </div>
</div>

<header id="siteHeader" class="hidden">
  <div class="header">
    <div class="top">
      <div class="logo">🛍️ Zunivo</div>
      <div class="actions">
        <button class="iconbtn" onclick="showNotifications()">🔔<span id="notifCount"></span></button>
        <button class="iconbtn" onclick="toggleProfileMenu()">👤</button>
      </div>
    </div>
    <div id="profileMenu" class="profile-menu">
      <div id="miniProfile"></div>
      <button onclick="showPanel('profile')">👤 Profile</button>
      <button onclick="showPanel('orders')">🛒 Orders</button>
      <button onclick="showPanel('sellerDashboard')">📊 Seller Dashboard</button>
      <button onclick="showPanel('referral')">🎁 Referral</button>
      <button onclick="showPanel('employees')">👥 Employees</button>
      <button onclick="showPanel('settings')">⚙️ Settings</button>
      <button onclick="logout()" class="danger">🚪 Logout</button>
    </div>
    <div class="nav">
      <button id="navHome" class="active" onclick="showPanel('home')">🏠 Home</button>
      <button onclick="showPanel('sell')">➕ Sell</button>
      <button onclick="showPanel('jobs')">💼 Jobs</button>
      <button onclick="showPanel('employees')">👥 Employees</button>
    </div>
  </div>
</header>

<main id="main" class="container hidden">
  <section id="homePanel">
    <div class="hero">
      <h1>Gura kandi ugurishe ibikwegereye</h1>
      <p>Zunivo ihuza abaguzi n'abacuruzi, ikabaha uburyo bwo kugura, kugurisha, gukunda, gutanga comments no kuganira live.</p>
      <button onclick="useLocation()">📍 Reba ibikwegereye</button>
    </div>
    <div class="search">
      <input id="search" placeholder="🔎 Shakisha igicuruzwa, category cyangwa umujyi..." oninput="loadProducts()">
      <div class="row" style="margin-top:7px">
        <button class="secondary" onclick="sortNearby()">📍 Ibiri hafi</button>
        <button class="secondary" onclick="loadProducts()">🌍 Byose</button>
      </div>
      <p id="locationStatus" class="muted"></p>
    </div>
    <div class="row" style="justify-content:space-between">
      <h2>🛍️ Ibicuruzwa</h2><span id="productCount" class="muted"></span>
    </div>
    <div id="products" class="grid"></div>
  </section>
