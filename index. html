<!DOCTYPE html>
<html lang="rw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#1769ff">
<title>Zunivo Marketplace</title>
<style>
*{box-sizing:border-box}
:root{--blue:#1769ff;--blue2:#0b4fd8;--bg:#f4f7fb;--text:#172033;--card:#fff;--muted:#6b7280;--danger:#e53935}
body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--text)}
button{border:0;border-radius:10px;padding:11px 14px;background:var(--blue);color:#fff;font-weight:700;cursor:pointer}
button.secondary{background:#e9f0ff;color:var(--blue)}
button.danger{background:#ffe8e8;color:#b42318}
button:disabled{opacity:.55;cursor:not-allowed}
header{position:sticky;top:0;z-index:100;background:#fff;border-bottom:1px solid #e6eaf0}
.header{max-width:1150px;margin:auto;padding:10px 14px}
.top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.logo{font-size:23px;font-weight:900;color:var(--blue)}
.actions{display:flex;gap:7px;align-items:center}
.iconbtn{background:#eef3ff;color:var(--blue);padding:10px 11px}
.nav{display:flex;gap:7px;overflow:auto;padding-top:9px}
.nav button{white-space:nowrap;background:#f1f4f8;color:#243047}
.nav button.active{background:var(--blue);color:#fff}
.container{max-width:1150px;margin:auto;padding:15px}
.hero{background:linear-gradient(135deg,#0b4fd8,#2b82ff);color:#fff;border-radius:20px;padding:24px;margin-bottom:15px}
.hero h1{margin:0 0 8px;font-size:29px}
.hero p{margin:7px 0 15px}
.search{background:#fff;padding:13px;border-radius:14px;margin-bottom:15px}
input,textarea,select{width:100%;padding:12px;border:1px solid #d6dce5;border-radius:10px;margin:5px 0;font:inherit;background:#fff}
textarea{min-height:90px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.card{background:var(--card);border-radius:16px;overflow:hidden;box-shadow:0 3px 14px #13294b12;border:1px solid #edf0f4}
.media{width:100%;height:205px;background:#e8eef8;object-fit:cover;display:block}
.cardbody{padding:13px}
.price{font-size:20px;font-weight:900;color:var(--blue)}
.muted{color:var(--muted);font-size:13px}
.badge{display:inline-block;background:#eaf1ff;color:var(--blue);padding:5px 8px;border-radius:30px;font-size:12px;font-weight:700}
.row{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.panel{background:#fff;border-radius:16px;padding:17px;margin-bottom:15px;box-shadow:0 3px 14px #13294b10}
.hidden{display:none!important}
.statgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
.stat{background:#f5f8ff;padding:15px;border-radius:13px}
.stat b{font-size:22px}
.profile{display:flex;align-items:center;gap:10px}
.avatar{width:45px;height:45px;border-radius:50%;object-fit:cover;background:#dce7ff;display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--blue)}
.modal{position:fixed;inset:0;background:#0008;display:none;align-items:center;justify-content:center;padding:14px;z-index:500}
.modal.show{display:flex}
.modalbox{background:#fff;width:min(620px,100%);max-height:92vh;overflow:auto;border-radius:18px;padding:18px}
.login-bg{background:linear-gradient(135deg,#063ea8,#3287ff);min-height:100vh;padding:25px 15px;display:flex;align-items:center;justify-content:center}
.loginbox{width:min(480px,100%);background:#fff;border-radius:22px;padding:22px;box-shadow:0 15px 50px #001d4d55}
.login-title{text-align:center;color:var(--blue);font-size:28px;font-weight:900}
.notice{background:#fff7df;border:1px solid #f2d37a;padding:11px;border-radius:10px;color:#6d5100}
.comment,.msg{padding:10px;border-bottom:1px solid #edf0f4}
.chat{height:300px;overflow:auto;background:#f4f6f9;border-radius:12px;padding:8px}
.my{background:#dfeaff;border-radius:10px;margin:5px 0;padding:9px;text-align:right}
.other{background:#fff;border-radius:10px;margin:5px 0;padding:9px}
.like{background:#fff0f1;color:#c62828}
.notif-list{max-height:350px;overflow:auto}
.notif{padding:11px;border-bottom:1px solid #edf0f4}
.unread{background:#eef4ff}
.profile-menu{position:absolute;right:12px;top:58px;background:#fff;border:1px solid #e3e8ef;border-radius:14px;box-shadow:0 8px 30px #0002;padding:8px;width:230px;display:none}
.profile-menu.show{display:block}
.profile-menu button{display:block;width:100%;text-align:left;margin:3px 0;background:#fff;color:#172033}
footer{background:#172033;color:#fff;text-align:center;padding:25px;margin-top:30px}
@media(max-width:650px){.hero h1{font-size:24px}.actions button span{display:none}.nav button{font-size:12px;padding:9px}.media{height:190px}}

/* HOME IS PUBLIC: login appears only when an action needs it */
#authScreen{display:none!important}
</style>
</head>
<body>

<div id="app"></div>

<!-- AUTH -->
<div id="authScreen" class="login-bg">
  <div class="loginbox">
    <div class="login-title">🛍️ Zunivo</div>
    <p style="text-align:center">Marketplace y'abaguzi n'abacuruzi</p>
    <div class="row">
      <button id="sellerLoginTab" style="flex:1" onclick="setRole('seller')">🏪 Kwinjira nk'umucuruzi</button>
      <button id="customerLoginTab" class="secondary" style="flex:1" onclick="setRole('customer')">🛒 Kwinjira nk'umukiriya</button>
    </div>
    <h3 id="authTitle">Kwinjira nk'umucuruzi</h3>
    <input id="authName" placeholder="Amazina (bisabwa kuri signup)">
    <input id="authEmail" type="email" placeholder="Email">
    <input id="authPassword" type="password" placeholder="Password">
    <input id="authCity" placeholder="Umujyi / Akarere">
    <div class="row">
      <button style="flex:1" onclick="signIn()">🔐 Injira</button>
      <button class="secondary" style="flex:1" onclick="signUp()">📝 Fungura account</button>
    </div>
    <p id="authMsg" class="muted"></p>
    <div class="notice">Kugira ngo login, products, comments, likes na chat bibe nyabyo, shyiramo Supabase URL na anon key muri code hepfo.</div>
  </div>
</div>

<header id="siteHeader" class="hidden">
  <div class="header">
    <div class="top">
      <div class="logo">🛍️ Zunivo</div>
      <div class="actions">
        <button class="iconbtn" onclick="showNotifications()">🔔<span id="notifCount"></span></button>
        <button class="iconbtn" onclick="toggleProfileMenu()">👤</button>
      </div>
    </div>
    <div id="profileMenu" class="profile-menu">
      <div id="miniProfile"></div>
      <button onclick="showPanel('profile')">👤 Profile</button>
      <button onclick="showPanel('orders')">🛒 Orders</button>
      <button onclick="showPanel('sellerDashboard')">📊 Seller Dashboard</button>
      <button onclick="showPanel('referral')">🎁 Referral</button>
      <button onclick="showPanel('employees')">👥 Employees</button>
      <button onclick="showPanel('settings')">⚙️ Settings</button>
      <button onclick="logout()" class="danger">🚪 Logout</button>
    </div>
    <div class="nav">
      <button id="navHome" class="active" onclick="showPanel('home')">🏠 Home</button>
      <button onclick="showPanel('sell')">➕ Sell</button>
      <button onclick="showPanel('jobs')">💼 Jobs</button>
      <button onclick="showPanel('employees')">👥 Employees</button>
    </div>
  </div>
</header>

<main id="main" class="container hidden">
  <section id="homePanel">
    <div class="hero">
      <h1>Gura kandi ugurishe ibikwegereye</h1>
      <p>Zunivo ihuza abaguzi n'abacuruzi, ikabaha uburyo bwo kugura, kugurisha, gukunda, gutanga comments no kuganira live.</p>
      <button onclick="useLocation()">📍 Reba ibikwegereye</button>
    </div>
    <div class="search">
      <input id="search" placeholder="🔎 Shakisha igicuruzwa, category cyangwa umujyi..." oninput="loadProducts()">
      <div class="row" style="margin-top:7px">
        <button class="secondary" onclick="sortNearby()">📍 Ibiri hafi</button>
        <button class="secondary" onclick="loadProducts()">🌍 Byose</button>
      </div>
      <p id="locationStatus" class="muted"></p>
    </div>
    <div class="row" style="justify-content:space-between">
      <h2>🛍️ Ibicuruzwa</h2><span id="productCount" class="muted"></span>
    </div>
    <div id="products" class="grid"></div>
  </section>

  <section id="sellPanel" class="panel hidden">
    <h2>➕ Shyira igicuruzwa ku isoko</h2>
    <input id="pName" placeholder="Izina ry'igicuruzwa">
    <textarea id="pDescription" placeholder="Sobanura igicuruzwa..."></textarea>
    <input id="pPrice" type="number" placeholder="Igiciro muri RWF">
    <input id="pCity" placeholder="Umujyi / Akarere">
    <select id="pCategory"><option>Imyenda</option><option>Telefone</option><option>Ibiribwa</option><option>Ibikoresho</option><option>Imodoka</option><option>Inzu</option><option>Ubwiza</option><option>Ibindi</option></select>
    <label><b>📷 Ifoto cyangwa 🎥 video</b></label>
    <input id="pMedia" type="file" accept="image/*,video/*">
    <button onclick="addProduct()">📤 Publish</button>
    <p id="uploadStatus" class="muted"></p>
  </section>

  <section id="ordersPanel" class="panel hidden">
    <h2>🛒 Orders</h2><div id="ordersList"></div>
  </section>

  <section id="sellerDashboardPanel" class="panel hidden">
    <h2>📊 Seller Dashboard</h2>
    <div class="statgrid">
      <div class="stat">📦 Products<br><b id="sProducts">0</b></div>
      <div class="stat">🛒 Orders<br><b id="sOrders">0</b></div>
      <div class="stat">❤️ Likes<br><b id="sLikes">0</b></div>
      <div class="stat">💰 Sales<br><b id="sSales">0 RWF</b></div>
    </div>
  </section>

  <section id="referralPanel" class="panel hidden">
    <h2>🎁 Referral</h2>
    <p>Code yawe:</p><h2 id="refCode">-</h2>
    <button onclick="copyReferral()">📋 Copy</button>
  </section>

  <section id="employeesPanel" class="panel hidden">
    <h2>👥 Employees</h2>
    <input id="employeeSearch" placeholder="Shakisha umwuga, skill cyangwa umujyi..." oninput="loadEmployees()">
    <div class="panel">
      <h3>📝 Kora profile y'umukozi</h3>
      <input id="eName" placeholder="Amazina">
      <input id="eJob" placeholder="Umwuga">
      <input id="eCity" placeholder="Umujyi / Akarere">
      <input id="eSkills" placeholder="Skills">
      <input id="eExperience" placeholder="Uburambe">
      <textarea id="eAbout" placeholder="Amakuru akwerekeye..."></textarea>
      <button onclick="addEmployee()">👤 Bika profile</button>
    </div>
    <div id="employeeList"></div>
  </section>

  <section id="jobsPanel" class="panel hidden">
    <h2>💼 Jobs</h2>
    <div class="panel">
      <input id="jobTitle" placeholder="Izina ry'akazi">
      <input id="jobCompany" placeholder="Company / Umukoresha">
      <input id="jobCity" placeholder="Umujyi / Akarere">
      <input id="jobSalary" placeholder="Umushahara">
      <textarea id="jobDescription" placeholder="Sobanura akazi..."></textarea>
      <button onclick="addJob()">📤 Publish Job</button>
    </div>
    <div id="jobList"></div>
  </section>

  <section id="profilePanel" class="panel hidden">
    <h2>👤 Profile</h2>
    <div class="profile"><img id="profileAvatar" class="avatar" alt=""><div><b id="profileName"></b><div id="profileEmail" class="muted"></div></div></div>
    <input id="profileCityEdit" placeholder="Umujyi / Akarere">
    <input id="profileAvatarUrl" placeholder="URL ya profile picture (optional)">
    <button onclick="saveProfile()">💾 Bika Profile</button>
  </section>

  <section id="settingsPanel" class="panel hidden">
    <h2>⚙️ Settings</h2>
    <button onclick="requestNotifications()">🔔 Emera Notifications</button>
    <p class="muted">Iyo notifications zemerewe, Zunivo ishobora kukwereka alerts mu gihe page ikiri gufunguye.</p>
  </section>
</main>

<footer id="siteFooter" class="hidden">🛍️ Zunivo Marketplace • Buy • Sell • Chat • Earn</footer>

<!-- LOGIN MODAL -->
<div id="authModal" class="modal"><div class="modalbox">
  <button class="secondary" onclick="closeModal('authModal')">← Komeza kuri Home</button>
  <div class="login-title">🔐 Zunivo Login</div>
  <p style="text-align:center">Hitamo uko ushaka gukoresha Zunivo</p>
  <div class="row">
    <button style="flex:1" onclick="setRole('seller');openAuthForm()">🏪 Umucuruzi</button>
    <button class="secondary" style="flex:1" onclick="setRole('customer');openAuthForm()">🛒 Umukiriya</button>
  </div>
  <div id="authForm" class="hidden" style="margin-top:12px">
    <h3 id="authTitleModal">Kwinjira</h3>
    <input id="authNameModal" placeholder="Amazina (bisabwa kuri signup)">
    <input id="authEmailModal" type="email" placeholder="Email">
    <input id="authPasswordModal" type="password" placeholder="Password">
    <input id="authCityModal" placeholder="Umujyi / Akarere">
    <div class="row">
      <button style="flex:1" onclick="signInModal()">🔐 Injira</button>
      <button class="secondary" style="flex:1" onclick="signUpModal()">📝 Fungura account</button>
    </div>
    <p id="authMsgModal" class="muted"></p>
  </div>
</div></div>

<!-- MODALS -->
<div id="detailModal" class="modal"><div class="modalbox"><button class="secondary" onclick="closeModal('detailModal')">← Back</button><div id="detailContent"></div></div></div>
<div id="chatModal" class="modal"><div class="modalbox"><button class="secondary" onclick="closeModal('chatModal')">← Back</button><h2>💬 Live Chat</h2><p id="chatTitle"></p><div id="chatBox" class="chat"></div><input id="chatInput" placeholder="Andika ubutumwa..."><button onclick="sendChat()">📤 Ohereza</button></div></div>
<div id="notifModal" class="modal"><div class="modalbox"><button class="secondary" onclick="closeModal('notifModal')">← Back</button><h2>🔔 Notifications</h2><div id="notifList" class="notif-list"></div></div></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* =========================
   ZUNIVO V3
   1) Create a Supabase project.
   2) Run supabase.sql.
   3) Create Storage buckets: product-media and avatars.
   4) Put your Supabase URL and anon key here.
========================= */
const SUPABASE_URL = "https://brettfrzuvyjrsbsjjml.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_aGs2zQzGZxOJYfuEznsvsQ_hyCkIXzY";
const sb = (SUPABASE_URL.startsWith("http") && !SUPABASE_ANON_KEY.includes("PASTE"))
  ? window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY) : null;

let me=null, role="seller", currentProduct=null, currentChat=null, productsCache=[];
const $=id=>document.getElementById(id);
const money=n=>Number(n||0).toLocaleString()+" RWF";
function configured(){return !!sb}
function msg(t){$("authMsg").textContent=t}
function setRole(r){role=r;$("authTitle").textContent=r==="seller"?"Kwinjira nk'umucuruzi":"Kwinjira nk'umukiriya";$("sellerLoginTab").className=r==="seller"?"":"secondary";$("customerLoginTab").className=r==="customer"?"":"secondary"}
async function signUp(){
 if(!configured()){msg("Banza ushyire Supabase URL na anon key muri code.");return}
 const email=$("authEmail").value.trim(), password=$("authPassword").value, name=$("authName").value.trim(), city=$("authCity").value.trim();
 if(!email||!password||!name){msg("Uzuza amazina, email na password.");return}
 const {data,error}=await sb.auth.signUp({email,password,options:{data:{name,role,city}}});
 if(error){msg(error.message);return}
 if(data.user){await ensureProfile(data.user);msg("Account yakozwe. Reba email yawe niba email confirmation isabwa.");}
}
async function signIn(){
 if(!configured()){msg("Banza ushyire Supabase URL na anon key muri code.");return}
 const {data,error}=await sb.auth.signInWithPassword({email:$("authEmail").value.trim(),password:$("authPassword").value});
 if(error){msg(error.message);return}
 await boot(data.user);
}
async function signUpModal(){
 if(!configured()){ $("authMsgModal").textContent="Supabase ntirateguwe."; return }
 const email=$("authEmailModal").value.trim(), password=$("authPasswordModal").value, name=$("authNameModal").value.trim(), city=$("authCityModal").value.trim();
 if(!email||!password||!name){$("authMsgModal").textContent="Uzuza amazina, email na password.";return}
 const {data,error}=await sb.auth.signUp({email,password,options:{data:{name,role,city}}});
 if(error){$("authMsgModal").textContent=error.message;return}
 if(data.user){await ensureProfile(data.user);$("authMsgModal").textContent="Account yakozwe. Niba email confirmation isabwa, banza wemeze email."; if(data.session) await boot(data.user);}
}
async function signInModal(){
 if(!configured()){ $("authMsgModal").textContent="Supabase ntirateguwe."; return }
 const {data,error}=await sb.auth.signInWithPassword({email:$("authEmailModal").value.trim(),password:$("authPasswordModal").value});
 if(error){$("authMsgModal").textContent=error.message;return}
 await boot(data.user); closeModal("authModal");
}

async function ensureProfile(user){
 const m=user.user_metadata||{};
 await sb.from("profiles").upsert({id:user.id,name:m.name||"Zunivo User",role:m.role||"customer",city:m.city||"",email:user.email},{onConflict:"id"});
}
async function boot(user){
 me=user; await ensureProfile(user);
 $("authScreen").classList.add("hidden");$("siteHeader").classList.remove("hidden");$("main").classList.remove("hidden");$("siteFooter").classList.remove("hidden");
 await loadProfile(); await loadProducts(); await loadNotifications(); await updateDashboard(); await loadEmployees(); await loadJobs(); subscribeRealtime();
}
function showLogin(){
  $("authModal").classList.add("show");
  $("authForm").classList.add("hidden");
}
function openAuthForm(){
  $("authModal").classList.add("show");
  $("authForm").classList.remove("hidden");
  $("authTitleModal").textContent=role==="seller"?"Kwinjira nk'umucuruzi":"Kwinjira nk'umukiriya";
}
async function logout(){if(sb) await sb.auth.signOut();location.reload()}
function toggleProfileMenu(){
 if(!me){
   showLogin();
   return;
 }
 $("profileMenu").classList.toggle("show");
}
function showPanel(name){
 const protectedPanels=["sell","orders","sellerDashboard","referral","employees","jobs","profile","settings"];
 if(protectedPanels.includes(name) && !me){ showLogin(); return; }
 document.querySelectorAll("main>section").forEach(x=>x.classList.add("hidden"));
 const p=$(name+"Panel"); if(p)p.classList.remove("hidden");
 if(name==="home"){$("navHome").classList.add("active");loadProducts()}else $("navHome").classList.remove("active");
 $("profileMenu").classList.remove("show");
 if(name==="orders")loadOrders();
 if(name==="sellerDashboard")updateDashboard();
 if(name==="referral")loadProfile();
 if(name==="employees")loadEmployees();
}
function closeModal(id){$(id).classList.remove("show")}
async function loadProfile(){
 if(!configured()||!me)return;
 const {data}=await sb.from("profiles").select("*").eq("id",me.id).single();
 if(!data)return;
 $("profileName").textContent=data.name||me.email;$("profileEmail").textContent=data.email||me.email;$("profileCityEdit").value=data.city||"";$("profileAvatarUrl").value=data.avatar_url||"";
 $("miniProfile").innerHTML=`<div class="profile"><img class="avatar" src="${data.avatar_url||""}" onerror="this.style.display='none'"><div><b>${escapeHtml(data.name||"User")}</b><div class="muted">${escapeHtml(data.role||"customer")}</div></div></div>`;
 $("refCode").textContent=data.referral_code||"-";
 $("profileAvatar").src=data.avatar_url||"";
}
async function saveProfile(){
 const {error}=await sb.from("profiles").update({city:$("profileCityEdit").value.trim(),avatar_url:$("profileAvatarUrl").value.trim()}).eq("id",me.id);
 alert(error?error.message:"✅ Profile yabitswe"); await loadProfile();
}
async function uploadMedia(file){
 if(!file) return null;
 const ext=(file.name.split(".").pop()||"bin").toLowerCase(), path=`${me.id}/${crypto.randomUUID()}.${ext}`;
 const {error}=await sb.storage.from("product-media").upload(path,file,{upsert:false,contentType:file.type});
 if(error)throw error;
 return sb.storage.from("product-media").getPublicUrl(path).data.publicUrl;
}
async function addProduct(){
 if(!configured()){alert("Shyiramo Supabase config mbere.");return}
 if(!me){alert("Banza winjire.");return}
 const name=$("pName").value.trim(), price=Number($("pPrice").value), file=$("pMedia").files[0];
 if(!name||!price||!file){alert("Uzuza izina, igiciro na file y'ifoto/video.");return}
 $("uploadStatus").textContent="⏳ Turimo kohereza file...";
 try{
   const media_url=await uploadMedia(file);
   const media_type=file.type.startsWith("video/")?"video":"image";
   const {error}=await sb.from("products").insert({seller_id:me.id,name,description:$("pDescription").value.trim(),price,city:$("pCity").value.trim(),category:$("pCategory").value,media_url,media_type});
   if(error)throw error;
   alert("✅ Product yashyizwe online.");
   ["pName","pDescription","pPrice","pCity"].forEach(id=>$(id).value="");$("pMedia").value="";$("uploadStatus").textContent="";
   showPanel("home");loadProducts();
 }catch(e){$("uploadStatus").textContent=e.message;alert(e.message)}
}
async function loadProducts(){
 if(!configured()){renderDemo();return}
 let q=sb.from("products").select("*,profiles:seller_id(name,avatar_url,city)").eq("status","active").order("created_at",{ascending:false});
 const s=$("search").value.trim(); if(s)q=q.or(`name.ilike.%${s}%,category.ilike.%${s}%,city.ilike.%${s}%`);
 const {data,error}=await q;if(error){$("products").innerHTML=`<div class="notice">${escapeHtml(error.message)}</div>`;return}
 productsCache=data||[];renderProducts(productsCache);
}
function renderDemo(){productsCache=[];$("products").innerHTML=`<div class="notice">Website irakora frontend, ariko products nyazo zizagaragara umaze gushyiramo Supabase URL/Key no gukoresha SQL setup.</div>`;$("productCount").textContent=""}
function renderProducts(list){
 $("productCount").textContent=list.length+" products";
 $("products").innerHTML=list.map(p=>`
 <article class="card">
 ${p.media_type==="video"?`<video class="media" src="${p.media_url}" controls></video>`:`<img class="media" src="${p.media_url}" alt="${escapeAttr(p.name)}" loading="lazy">`}
 <div class="cardbody"><span class="badge">${escapeHtml(p.category||"Ibindi")}</span>
 <h3>${escapeHtml(p.name)}</h3><div class="price">${money(p.price)}</div><p>${escapeHtml(p.description||"")}</p>
 <div class="muted">📍 ${escapeHtml(p.city||"")} · 👤 ${escapeHtml(p.profiles?.name||"Seller")}</div>
 <div class="row" style="margin-top:10px">
 <button onclick="openProduct('${p.id}')">👀 Reba</button>
 <button class="like" onclick="toggleLike('${p.id}')">❤️ <span id="like-${p.id}">...</span></button>
 <button class="secondary" onclick="openChat('${p.id}')">💬 Chat</button>
 </div></div></article>`).join("");
 list.forEach(p=>loadLikeCount(p.id));
}
async function loadLikeCount(id){
 if(!sb)return;const {count}=await sb.from("product_likes").select("*",{count:"exact",head:true}).eq("product_id",id);if($("like-"+id))$("like-"+id).textContent=count||0;
}
async function toggleLike(id){
 if(!me){alert("Banza winjire.");return}
 const {data}=await sb.from("product_likes").select("product_id").eq("product_id",id).eq("user_id",me.id).maybeSingle();
 if(data) await sb.from("product_likes").delete().eq("product_id",id).eq("user_id",me.id);
 else await sb.from("product_likes").insert({product_id:id,user_id:me.id});
 loadLikeCount(id);
}
async function openProduct(id){
 const p=productsCache.find(x=>x.id===id);if(!p)return;currentProduct=p;
 $("detailContent").innerHTML=`
 ${p.media_type==="video"?`<video class="media" src="${p.media_url}" controls></video>`:`<img class="media" src="${p.media_url}" alt="">`}
 <h2>${escapeHtml(p.name)}</h2><div class="price">${money(p.price)}</div><p>${escapeHtml(p.description||"")}</p>
 <p class="muted">📍 ${escapeHtml(p.city||"")} · 👤 ${escapeHtml(p.profiles?.name||"Seller")}</p>
 <div class="row"><button onclick="buyProduct('${p.id}')">🛒 Gura</button><button class="like" onclick="toggleLike('${p.id}')">❤️ Like</button><button class="secondary" onclick="openChat('${p.id}')">💬 Live Chat</button></div>
 <hr><h3>💬 Comments</h3><div id="comments"></div><input id="commentText" placeholder="Andika comment..."><button onclick="addComment('${p.id}')">💬 Ohereza</button>`;
 $("detailModal").classList.add("show");loadComments(id);
}
async function loadComments(id){
 const box=$("comments");if(!box)return;const {data,error}=await sb.from("comments").select("*,profiles:user_id(name,avatar_url)").eq("product_id",id).order("created_at",{ascending:true});
 if(error){box.textContent=error.message;return}
 box.innerHTML=(data||[]).map(c=>`<div class="comment"><b>${escapeHtml(c.profiles?.name||"User")}</b><br>${escapeHtml(c.body)}</div>`).join("")||"<p class='muted'>Nta comments.</p>";
}
async function addComment(id){
 if(!me){alert("Banza winjire.");return}const body=$("commentText").value.trim();if(!body)return;
 const {error}=await sb.from("comments").insert({product_id:id,user_id:me.id,body});if(error)alert(error.message);else{$("commentText").value="";loadComments(id)}
}
async function buyProduct(id){
 if(!me){alert("Banza winjire.");return}const p=productsCache.find(x=>x.id===id);if(!p)return;
 const {error}=await sb.from("orders").insert({product_id:id,buyer_id:me.id,seller_id:p.seller_id,amount:p.price,status:"pending"});
 if(error)alert(error.message);else{alert("🎉 Order yakiriwe.");await loadOrders()}
}
async function loadOrders(){
 const box=$("ordersList");if(!configured())return;
 const {data,error}=await sb.from("orders").select("*,products(name,media_url)").or(`buyer_id.eq.${me.id},seller_id.eq.${me.id}`).order("created_at",{ascending:false});
 if(error){box.textContent=error.message;return}
 box.innerHTML=(data||[]).map(o=>`<div class="job-card"><b>🛒 ${escapeHtml(o.products?.name||"Product")}</b><p>${money(o.amount)} · ${escapeHtml(o.status)}</p></div>`).join("")||"<p class='muted'>Nta orders.</p>";
}
async function updateDashboard(){
 if(!configured()||!me)return;
 const [{count:pc},{count:oc},{count:lc},{data:orders}]=await Promise.all([
  sb.from("products").select("*",{count:"exact",head:true}).eq("seller_id",me.id),
  sb.from("orders").select("*",{count:"exact",head:true}).eq("seller_id",me.id),
  sb.from("product_likes").select("product_id,products!inner(seller_id)",{count:"exact",head:true}).eq("products.seller_id",me.id),
  sb.from("orders").select("amount").eq("seller_id",me.id).eq("status","completed")
 ]);
 $("sProducts").textContent=pc||0;$("sOrders").textContent=oc||0;$("sLikes").textContent=lc||0;$("sSales").textContent=money((orders||[]).reduce((a,b)=>a+Number(b.amount||0),0));
}
async function loadEmployees(){
 if(!configured())return;let q=sb.from("employees").select("*,profiles:user_id(name,avatar_url)").order("created_at",{ascending:false});const s=$("employeeSearch").value.trim();if(s)q=q.or(`job.ilike.%${s}%,city.ilike.%${s}%,skills.ilike.%${s}%`);
 const {data}=await q;$("employeeList").innerHTML=(data||[]).map(e=>`<div class="job-card"><h3>👤 ${escapeHtml(e.name)}</h3><div class="muted">💼 ${escapeHtml(e.job)} · 📍 ${escapeHtml(e.city)}</div><p><b>Skills:</b> ${escapeHtml(e.skills||"")}</p><p>${escapeHtml(e.about||"")}</p></div>`).join("");
}
async function addEmployee(){
 if(!me){alert("Banza winjire.");return}
 const name=$("eName").value.trim(),job=$("eJob").value.trim(),city=$("eCity").value.trim();if(!name||!job||!city){alert("Uzuza amazina, umwuga n'aho uri.");return}
 const {error}=await sb.from("employees").insert({user_id:me.id,name,job,city,skills:$("eSkills").value.trim(),experience:$("eExperience").value.trim(),about:$("eAbout").value.trim()});
 if(error)alert(error.message);else{alert("✅ Employee profile yabitswe.");loadEmployees()}
}
async function loadJobs(){
 if(!configured())return;const {data}=await sb.from("jobs").select("*").order("created_at",{ascending:false});$("jobList").innerHTML=(data||[]).map(j=>`<div class="job-card"><h3>💼 ${escapeHtml(j.title)}</h3><div class="muted">🏢 ${escapeHtml(j.company)} · 📍 ${escapeHtml(j.city)}</div><p>💰 ${escapeHtml(j.salary||"Negotiable")}</p><p>${escapeHtml(j.description||"")}</p><button onclick="applyJob('${j.id}')">📩 Apply</button></div>`).join("");
}
async function addJob(){
 if(!me){alert("Banza winjire.");return}const title=$("jobTitle").value.trim(),company=$("jobCompany").value.trim(),city=$("jobCity").value.trim();if(!title||!company||!city){alert("Uzuza title, company na city.");return}
 const {error}=await sb.from("jobs").insert({user_id:me.id,title,company,city,salary:$("jobSalary").value.trim(),description:$("jobDescription").value.trim()});if(error)alert(error.message);else{alert("✅ Job yashyizwe ku isoko.");loadJobs()}
}
async function applyJob(id){if(!me){alert("Banza winjire.");return}const {error}=await sb.from("job_applications").insert({job_id:id,applicant_id:me.id});alert(error?error.message:"✅ Application yakiriwe.")}
async function openChat(productId){
 if(!me){alert("Banza winjire.");return}currentChat=productId;const p=productsCache.find(x=>x.id===productId);$("chatTitle").textContent=p?"Ku gicuruzwa: "+p.name:"Live Chat";$("chatModal").classList.add("show");await loadChat();
}
async function loadChat(){
 const {data,error}=await sb.from("messages").select("*,profiles:user_id(name)").eq("product_id",currentChat).order("created_at",{ascending:true});if(error){$("chatBox").textContent=error.message;return}
 $("chatBox").innerHTML=(data||[]).map(m=>`<div class="${m.user_id===me.id?'my':'other'}"><b>${escapeHtml(m.profiles?.name||"User")}</b><br>${escapeHtml(m.body)}</div>`).join("");
 $("chatBox").scrollTop=$("chatBox").scrollHeight;
}
async function sendChat(){const body=$("chatInput").value.trim();if(!body||!currentChat)return;const {error}=await sb.from("messages").insert({product_id:currentChat,user_id:me.id,body});if(error)alert(error.message);else{$("chatInput").value="";loadChat()}}
async function loadNotifications(){
 if(!configured()||!me)return;const {data}=await sb.from("notifications").select("*").eq("user_id",me.id).order("created_at",{ascending:false}).limit(50);window.notifs=data||[];renderNotifCount();
}
window.notifs=[];
function renderNotifCount(){const n=window.notifs.filter(x=>!x.read_at).length;$("notifCount").textContent=n?` ${n}`:""}
function showNotifications(){const list=$("notifList");list.innerHTML=window.notifs.map(n=>`<div class="notif ${n.read_at?'':'unread'}"><b>${escapeHtml(n.title||"Zunivo")}</b><br>${escapeHtml(n.body||"")}</div>`).join("")||"<p class='muted'>Nta notification.</p>";$("notifModal").classList.add("show")}
async function requestNotifications(){if(!("Notification"in window)){alert("Browser yawe ntiyashyigikira notifications.");return}const p=await Notification.requestPermission();alert(p==="granted"?"✅ Notifications zemerewe.":"Notifications ntizemerewe.")}
function subscribeRealtime(){
 if(!sb)return;
 sb.channel("zunivo-realtime").on("postgres_changes",{event:"INSERT",schema:"public",table:"messages"},payload=>{if(payload.new.product_id===currentChat)loadChat()})
 .on("postgres_changes",{event:"INSERT",schema:"public",table:"comments"},payload=>{if(currentProduct&&payload.new.product_id===currentProduct.id)loadComments(currentProduct.id)})
 .on("postgres_changes",{event:"INSERT",schema:"public",table:"notifications",filter:`user_id=eq.${me.id}`},payload=>{window.notifs.unshift(payload.new);renderNotifCount();if(Notification.permission==="granted")new Notification(payload.new.title||"Zunivo",{body:payload.new.body||""})})
 .subscribe();
}
async function useLocation(){if(!navigator.geolocation){alert("Location ntishyigikiwe.");return}navigator.geolocation.getCurrentPosition(p=>$("locationStatus").textContent=`📍 Location: ${p.coords.latitude.toFixed(4)}, ${p.coords.longitude.toFixed(4)}`,()=>alert("Emera Location muri browser."))}
function sortNearby(){useLocation();loadProducts()}
async function copyReferral(){await navigator.clipboard.writeText($("refCode").textContent);alert("✅ Referral code yakopowe.")}
function escapeHtml(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[m]))}
function escapeAttr(s){return escapeHtml(s)}
async function registerSW(){if("serviceWorker"in navigator)navigator.serviceWorker.register("sw.js").catch(()=>{})}
(async()=>{
 $("siteHeader").classList.remove("hidden");
 $("main").classList.remove("hidden");
 $("siteFooter").classList.remove("hidden");
 if(configured()){const {data}=await sb.auth.getSession();if(data.session)await boot(data.session.user);else await loadProducts();}
 else {renderDemo();}
})();
</script>
